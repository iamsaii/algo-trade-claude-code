{
  "name": "algo-trading-framework",
  "version": "1.0.0",
  "description": "Production-ready Node.js algorithmic trading framework with backtesting, paper trading, and live trading capabilities",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "start:paper": "node src/app.js --mode paper",
    "start:backtest": "node src/app.js --mode backtest",
    "ai:decide": "node src/app.js --mode ai",
    "ai:live": "node src/app.js --mode ai --live",
    "ai:eod": "node src/app.js --mode eod",
    "ai:check": "node src/app.js --mode check",
    "test": "node tests/runTests.js",
    "generate-data": "node src/data/sampleData.js"
  },
  "keywords": [
    "algorithmic-trading",
    "trading-bot",
    "backtesting",
    "paper-trading",
    "kite-connect",
    "zerodha",
    "stock-market"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.6.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "kiteconnect": "^5.3.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
